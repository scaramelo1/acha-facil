# 20/11/2026 (passo 17 do Plano D, pedido do usuário): o Acha Fácil saiu do Google e o guia público fechou.
# Tudo com noindex; as páginas públicas mostram fechado.php ("agora é Localiza Fácil", link comum, SEM redirecionar).
# Abertos (fora do Google): admin/ (só admins), api/, google/, painel/, planos, perfil, assinatura, suporte, busca.php,
# minha-conta, entrar/sair, termos, privacidade, mp-webhook e arquivos (assets, fotos). Desfazer: backups/htaccess.antes-fechar.20261120
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
# Copiado para servidor/publico/.htaccess por servidor/dominio/ativar.sh (só depois do HTTPS do domínio novo funcionar).
# Quem abre fsadesigners.com.br/acha-facil/... vai para achafacilapp.com.br/...
# Ficam no endereço antigo: api/ (os APKs já instalados chamam fsadesigners.com.br/acha-facil/api, com POST)
# e mp-webhook.php (endereço cadastrado no Mercado Pago, chega por POST).
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?fsadesigners\.com\.br$ [NC]
RewriteCond %{REQUEST_URI} !^/acha-facil/(api/|mp-webhook\.php)
RewriteRule ^(.*)$ https://achafacilapp.com.br/$1 [R=301,L,NE]
# www.achafacilapp.com.br -> achafacilapp.com.br
RewriteCond %{HTTP_HOST} ^www\.achafacilapp\.com\.br$ [NC]
RewriteRule ^(.*)$ https://achafacilapp.com.br/$1 [R=301,L,NE]
# 20/11 (passo 17 do Plano D): inicial, incluir e baixar APK fecharam
RewriteCond %{HTTP_HOST} ^achafacilapp\.com\.br$ [NC]
RewriteRule ^(index\.php|incluir\.php|incluir-evento\.php|baixar-apk\.php)?$ fechado.php [L]
# Páginas públicas de cidade, área, tipo, ficha e sitemaps (eram web.php): agora fechado.php (410)
RewriteCond %{HTTP_HOST} ^achafacilapp\.com\.br$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ fechado.php [L]
# Divulgar um evento (passo 36): o cartaz pode ter até 8 MB (o php.ini global é 2M/8M)
<Files "incluir-evento.php">
  <IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
  </IfModule>
</Files>
# 19/11 (avaliação do site): cache no navegador. O CSS sempre vai com ?v=N (pagina.php e admin.php; subir o N ao mudar),
# então pode ficar 1 ano. Ícones, logo e imagens de compartilhar (assets/og/) por 7 dias.
<IfModule mod_headers.c>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|ico|jpg|webp|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
